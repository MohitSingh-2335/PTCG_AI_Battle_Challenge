# ============================================================================
# GITIGNORE FOR PTCG AI BATTLE CHALLENGE
# ============================================================================

# Byte-compiled / Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Compiled native C++ binaries & libraries
*.dll
*.so
*.dylib

# Submission archives & compressed packages (keep repo lightweight)
*.tar.gz
*.zip
archive/

# Raw replay datasets & local data folders (large JSON replay dumps)
**/Data/
Data/
*.jsonl
*.json

# Temporary runs, logs & sandbox folders
simulation/temp_submission_test/
simulation/v10_audit_sandbox/
*.tmp
*.log

# Environment & Secrets
.env
.venv/
env/

# IDE & OS specific files
.DS_Store
Thumbs.db
.vscode/
.idea/
.gemini/
